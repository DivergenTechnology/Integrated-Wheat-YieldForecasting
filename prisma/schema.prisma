generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Zone {
  id           String       @id @default(cuid())
  name         String
  cropType     String // maize | wheat | soybean | rice | cotton
  areaHectares Float
  soilType     String?
  description  String?
  readings     ZoneReading[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model ZoneReading {
  id          String   @id @default(cuid())
  zoneId      String
  zone        Zone     @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  surveyDate  DateTime
  growthStage String // early | mid | late
  ndvi        Float
  gndvi       Float
  ndre        Float
  lai         Float
  canopyCover Float // percentage 0-100
  droneModel  String?
  sensorType  String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([zoneId, surveyDate])
}
